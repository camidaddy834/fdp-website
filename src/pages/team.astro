---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TEAM, TEAM_GROUPS } from "../data/company";

// Monogram initials from a member name (drops any credential after a comma)
function initials(name: string): string {
  const parts = name.split(",")[0].trim().split(/\s+/).filter(Boolean);
  if (!parts.length) return "FDP";
  return (parts[0][0] + (parts[1]?.[0] ?? "")).toUpperCase();
}

// Last name for alphabetical sorting (drops any credential after a comma)
function lastName(name: string): string {
  const parts = name.split(",")[0].trim().split(/\s+/);
  return parts[parts.length - 1] ?? name;
}

const leads = TEAM.members.filter((m) => m.lead);
// All other groups, in display order, alphabetical by last name within each
const groups = TEAM_GROUPS.filter((g) => g !== "Leadership").map((group) => ({
  group,
  members: TEAM.members
    .filter((m) => m.group === group)
    .sort((a, b) => lastName(a.name).localeCompare(lastName(b.name))),
}));
---

<BaseLayout title="Team" description="Meet the food service designers, project managers, and specialists behind FDP.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Our Team</p>
      <h1 class="page-title">Every project gets the whole team.</h1>
      <p class="page-lede">
        Food service design is detail work, and no great kitchen is designed by
        one person. From leadership to project management, engineering, and
        construction administration, every FDP project draws on the full depth
        of our team.
      </p>
    </div>
  </section>

  <!-- Leadership -->
  <section class="section-tight">
    <div class="container">
      <p class="eyebrow">Leadership</p>
      <div class="team-grid lead-grid">
        {
          leads.map((m) => (
            <article class="member">
              <div class="member-photo">
                {m.photo ? (
                  <img src={m.photo} alt={m.name} width="360" height="360" />
                ) : (
                  <div class="monogram" aria-hidden="true"><span>{initials(m.name)}</span></div>
                )}
              </div>
              <h3 class="member-name">{m.name}</h3>
              <p class="member-title">{m.title}</p>
              <p class="member-loc">{m.location}</p>
              {m.bio && <p class="member-bio">{m.bio}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Team grouped by discipline -->
  {
    groups.map(({ group, members }) => (
      <section class="section-tight office-section">
        <div class="container">
          <div class="office-head">
            <p class="eyebrow">{group}</p>
          </div>
          <div class="team-grid">
            {members.map((m) => (
              <article class="member">
                <div class="member-photo">
                  {m.photo ? (
                    <img src={m.photo} alt={m.name} width="360" height="360" />
                  ) : (
                    <div class="monogram" aria-hidden="true"><span>{initials(m.name)}</span></div>
                  )}
                </div>
                <h3 class="member-name">{m.name}</h3>
                <p class="member-title">{m.title}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="join">
    <div class="container join-inner">
      <div>
        <p class="eyebrow on-dark">Careers</p>
        <h2 class="join-title">Interested in joining FDP?</h2>
        <p class="join-lede">
          We're always glad to hear from food service designers and project
          managers who care about getting the details right.
        </p>
      </div>
      <a href="/contact" class="btn btn-primary join-btn">Get in touch</a>
    </div>
  </section>

  <style>
    .page-head{padding:clamp(48px,7vw,90px) 0 10px}
    .page-title{font-size:clamp(2.4rem,5vw,3.7rem);font-weight:800;max-width:16ch;margin:16px 0 18px}
    .page-lede{color:var(--ink-soft);max-width:60ch;font-size:1.15rem;line-height:1.6}

    .team-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,3vw,34px)}
    .member{display:flex;flex-direction:column}
    .member-photo{margin-bottom:16px}
    .member-photo img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:var(--radius-lg)}
    .monogram{width:100%;font-size:clamp(2rem,4vw,2.8rem);border-radius:var(--radius-lg)}
    .monogram{border-radius:var(--radius-lg)}
    .member-name{font-size:1.32rem;font-weight:700}
    .member-title{font-family:var(--font-mono);font-size:.82rem;letter-spacing:.04em;text-transform:uppercase;color:var(--accent-ink);margin:4px 0 0}
    .member-loc{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:5px 0 0}
    .member-bio{color:var(--ink-soft);font-size:.96rem;margin-top:10px}

    .lead-grid{grid-template-columns:repeat(2,minmax(0,300px))}
    .office-section{padding-top:clamp(26px,4vw,42px)}
    .office-head{display:flex;align-items:baseline;gap:12px;margin-bottom:24px;padding-bottom:12px;border-bottom:1px solid var(--line-strong)}
    .office-count{font-family:var(--font-mono);font-size:12px;color:var(--muted)}
    @media (max-width:820px){.team-grid{grid-template-columns:1fr 1fr}}
    @media (max-width:520px){.team-grid,.lead-grid{grid-template-columns:1fr}}

    .join{background:var(--ink-900);color:#fff;margin-top:clamp(50px,7vw,90px)}
    .join-inner{display:flex;justify-content:space-between;align-items:center;gap:36px;padding:clamp(46px,7vw,80px) 0;flex-wrap:wrap}
    .join-title{font-size:clamp(1.7rem,3.2vw,2.5rem);font-weight:800;color:#fff;margin:12px 0 12px}
    .join-lede{color:#b8c0c8;max-width:50ch}
    .join .btn-primary{background:#fff;color:var(--accent)}
    .join .btn-primary:hover{background:var(--steel-wash)}
    .join-btn{white-space:nowrap}
  </style>
</BaseLayout>
