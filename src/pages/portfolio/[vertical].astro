---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { VERTICAL_META } from "../../data/site";
import { VERTICALS } from "../../content.config";

export function getStaticPaths() {
  return VERTICALS.map((v) => ({ params: { vertical: v } }));
}

const { vertical } = Astro.params;
const meta = VERTICAL_META[vertical as (typeof VERTICALS)[number]];
const projects = (await getCollection("projects"))
  .filter((p) => !p.data.draft && p.data.sector === vertical)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={meta.label} description={meta.blurb}>
  <section class="page-head">
    <div class="container">
      <p class="crumb"><a href="/portfolio">Portfolio</a> <span>/</span> {meta.label}</p>
      <h1 class="page-title">{meta.label}</h1>
      <p class="page-lede">{meta.blurb}</p>
      <div class="filters">
        <a href="/portfolio" class="chip">All</a>
        {
          VERTICALS.map((v) => (
            <a
              href={`/portfolio/${v}/`}
              class:list={["chip", { "chip-active": v === vertical }]}
            >
              {VERTICAL_META[v].label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      {
        projects.length > 0 ? (
          <div class="grid">
            {projects.map((p) => <ProjectCard project={p} />)}
          </div>
        ) : (
          <div class="empty">
            <p>Case studies for this sector are being added.</p>
            <a href="/contact" class="btn btn-ghost">Ask about our {meta.label.toLowerCase()} work</a>
          </div>
        )
      }
    </div>
  </section>

  <style>
    .page-head{padding:clamp(48px,7vw,86px) 0 10px}
    .crumb{font-family:var(--font-mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
    .crumb a{color:var(--accent-ink);text-decoration:none}
    .crumb span{margin:0 6px;opacity:.5}
    .page-title{font-size:clamp(2.4rem,5vw,3.6rem);font-weight:800;margin:0 0 14px}
    .page-lede{color:var(--ink-soft);max-width:56ch;font-size:1.1rem}
    .filters{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
    .chip{
      display:inline-flex;text-decoration:none;color:var(--ink-soft);
      font-family:var(--font-display);font-weight:600;font-size:.9rem;
      background:var(--paper);border:1px solid var(--line);border-radius:24px;padding:8px 15px;
    }
    .chip:hover{border-color:var(--line-strong);color:var(--ink)}
    .chip-active{background:var(--accent);color:#fff;border-color:var(--accent)}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
    @media (max-width:920px){.grid{grid-template-columns:1fr 1fr}}
    @media (max-width:600px){.grid{grid-template-columns:1fr}}
    .empty{text-align:center;padding:60px 20px;display:flex;flex-direction:column;align-items:center;gap:18px;color:var(--muted)}
  </style>
</BaseLayout>
