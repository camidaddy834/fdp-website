---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { VERTICAL_META, SITE } from "../../data/site";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter((p) => !p.data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const d = project.data;
const meta = VERTICAL_META[d.sector];
const { Content } = await render(project);

// Always show the core facts during review; a blank renders as "—" so the
// missing value is an obvious reminder. (Swap to a .filter(Boolean) to hide
// blanks once the data is confirmed.)
const facts: { k: string; v: string | null }[] = [
  { k: "Location", v: d.location ?? null },
  { k: "Completed", v: d.year ? String(d.year) : null },
  { k: "Area", v: d.squareFeet ? `${d.squareFeet.toLocaleString()} sq ft` : null },
  { k: "Seats", v: d.seats ? d.seats.toLocaleString() : null },
];
---

<BaseLayout title={d.title} description={d.summary}>
  <article>
    <!-- Header -->
    <header class="cs-head">
      <div class="container">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/portfolio">Portfolio</a> <span aria-hidden="true">/</span>
          <a href={`/portfolio/${d.sector}/`}>{meta.label}</a>
        </nav>
        <h1 class="cs-title">{d.title}</h1>
        <p class="cs-summary">{d.summary}</p>
      </div>
    </header>

    <!-- Hero image or branded placeholder -->
    <div class="container">
      {
        d.heroImage ? (
          <Image
            src={d.heroImage}
            alt={d.title}
            widths={[480, 768, 1180]}
            sizes="(min-width: 1180px) 1180px, 100vw"
            class="cs-hero"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="cs-hero cs-hero-ph" aria-hidden="true">
            <span>FDP</span>
          </div>
        )
      }
    </div>

    <!-- Facts + narrative -->
    <div class="container cs-body">
      <aside class="cs-facts">
        <dl>
          {
            facts.map((f) => (
              <div class="fact">
                <dt>{f.k}</dt>
                <dd class:list={["tabular", { "fact-tbd": !f.v }]}>{f.v ?? "—"}</dd>
              </div>
            ))
          }
          {
            d.services.length > 0 && (
              <div class="fact">
                <dt>Services</dt>
                <dd>
                  <ul class="svc">
                    {d.services.map((s) => <li>{s}</li>)}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
        <a href="/contact#proposal-form" class="btn btn-primary cs-cta">Start a similar project</a>
      </aside>

      <div class="cs-prose">
        <Content />
      </div>
    </div>

    <!-- Gallery -->
    {
      d.gallery.length > 0 && (
        <div class="container cs-gallery">
          {d.gallery.map((img) => (
            <Image
              src={img}
              alt={`${d.title} — detail`}
              widths={[480, 720]}
              sizes="(max-width: 820px) 100vw, 50vw"
            />
          ))}
        </div>
      )
    }

    <!-- Foot CTA -->
    <section class="cs-foot">
      <div class="container cs-foot-inner">
        <h2>Planning a {meta.label.toLowerCase()} facility?</h2>
        <p>Tell us the scope — proposals go to <a href={`mailto:${SITE.proposalEmail}`}>{SITE.proposalEmail}</a>.</p>
        <a href="/contact#proposal-form" class="btn btn-primary">Request a proposal</a>
      </div>
    </section>
  </article>

  <style>
    .cs-head{padding:clamp(44px,6vw,80px) 0 30px}
    .crumb{font-family:var(--font-mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:16px}
    .crumb a{color:var(--accent-ink);text-decoration:none}
    .crumb a:hover{text-decoration:underline}
    .crumb span{margin:0 6px;opacity:.5}
    .cs-title{font-size:clamp(2.3rem,5vw,3.7rem);font-weight:800;max-width:16ch;margin-bottom:18px}
    .cs-summary{font-size:clamp(1.1rem,2vw,1.4rem);color:var(--ink-soft);max-width:58ch;line-height:1.5}

    .cs-hero{width:100%;aspect-ratio:1180/620;object-fit:cover;border-radius:var(--radius-lg);box-shadow:var(--shadow)}
    .cs-hero-ph{
      display:grid;place-items:center;
      background:
        radial-gradient(120% 120% at 25% 15%, #2c4d84 0%, transparent 55%),
        radial-gradient(120% 120% at 85% 95%, #9aa3b3 0%, transparent 60%),
        var(--ink-900);
    }
    .cs-hero-ph span{font-family:var(--font-display);font-weight:800;font-size:clamp(3rem,8vw,6rem);letter-spacing:.14em;color:rgba(255,255,255,.24)}

    .cs-body{display:grid;grid-template-columns:290px 1fr;gap:clamp(30px,5vw,64px);padding:clamp(40px,6vw,72px) 0}
    .cs-facts{position:sticky;top:96px;align-self:start}
    .cs-facts dl{
      background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);
      padding:8px 20px;box-shadow:var(--shadow-sm);
    }
    .fact{padding:16px 0;border-bottom:1px solid var(--line)}
    .fact:last-child{border-bottom:none}
    .fact dt{font-family:var(--font-mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
    .fact dd{margin:0;font-family:var(--font-display);font-weight:600;font-size:1.08rem;color:var(--ink)}
    .fact dd.fact-tbd{color:var(--muted);font-weight:500}
    .svc{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:5px}
    .svc li{font-size:.95rem;font-weight:500;color:var(--ink-soft);font-family:var(--font-body)}
    .cs-cta{width:100%;justify-content:center;margin-top:18px}

    .cs-prose{font-size:1.12rem;line-height:1.75;color:var(--ink-soft);max-width:66ch}
    .cs-prose :global(h2){font-family:var(--font-display);font-size:1.7rem;font-weight:700;color:var(--ink);margin:2.2rem 0 .8rem}
    .cs-prose :global(h2:first-child){margin-top:0}
    .cs-prose :global(p){margin:0 0 1.1rem}
    .cs-prose :global(strong){color:var(--ink)}

    .cs-gallery{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding-bottom:clamp(30px,5vw,60px)}
    .cs-gallery :global(img){width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;display:block;border-radius:var(--radius);box-shadow:var(--shadow-sm)}

    .cs-foot{background:var(--ink-900);color:#fff}
    .cs-foot-inner{text-align:center;padding:clamp(48px,7vw,84px) 0;display:flex;flex-direction:column;align-items:center;gap:14px}
    .cs-foot h2{font-size:clamp(1.7rem,3.2vw,2.5rem);font-weight:800;color:#fff}
    .cs-foot p{color:#b8c0c8}
    .cs-foot a{color:var(--on-dark-accent)}
    .cs-foot .btn{margin-top:12px}
    .cs-foot .btn-primary{background:#fff;color:var(--accent)}
    .cs-foot .btn-primary:hover{background:var(--steel-wash)}

    @media (max-width:820px){
      .cs-body{grid-template-columns:1fr}
      .cs-facts{position:static}
      .cs-gallery{grid-template-columns:1fr}
    }
  </style>
</BaseLayout>
