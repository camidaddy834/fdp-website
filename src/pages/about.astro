---
import BaseLayout from "../layouts/BaseLayout.astro";
import { OFFICES } from "../data/site";
import { MISSION, CERTIFICATIONS, TEAM } from "../data/company";

const approach = [
  {
    n: "01",
    h: "Master planning",
    p: "We start with flow — people, food, and waste — and plan the facility around how it will actually run, not just how it looks on a floor plate.",
  },
  {
    n: "02",
    h: "Foodservice design",
    p: "Detailed kitchen and servery design, coordinated with architecture, MEP, and your operators so nothing gets value-engineered into a bottleneck.",
  },
  {
    n: "03",
    h: "Equipment specification",
    p: "A complete, biddable equipment package — schedules, cut sheets, and utility requirements — that protects your budget through procurement.",
  },
];

function initials(name: string): string {
  const clean = name.replace(/[\[\]]/g, "").trim();
  const parts = clean.split(/\s+/).filter(Boolean);
  if (!parts.length) return "FDP";
  return (parts[0][0] + (parts[1]?.[0] ?? "")).toUpperCase();
}
---

<BaseLayout title="Who We Are" description="FDP is a Texas-based foodservice facility design firm serving higher education, corporate, healthcare, casinos, culinary, and K-12 clients.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Who We Are</p>
      <h1 class="page-title">Foodservice design is all we do.</h1>
      <p class="page-lede">
        FDP is a Texas-based foodservice facility design and consulting firm. For
        more than three decades we've planned kitchens, serveries, and dining
        environments that have to perform under real-world volume — day in and
        day out, for years.
      </p>
    </div>
  </section>

  <!-- Mission -->
  <section class="mission">
    <div class="container">
      <div class="mission-head">
        <p class="eyebrow">Our Mission</p>
        {MISSION.placeholder && <span class="ph-flag">Placeholder — replace with FDP's mission statement</span>}
      </div>
      <p class="mission-statement">{MISSION.statement}</p>
      <div class="values">
        {
          MISSION.values.map((v) => (
            <div class="value">
              <h3 class="value-h">{v.title}</h3>
              <p class="value-p">{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section-tight">
    <div class="container">
      <p class="eyebrow" style="margin-bottom:24px">How we work</p>
      <div class="approach">
        {
          approach.map((a) => (
            <div class="ap">
              <span class="ap-n tabular">{a.n}</span>
              <h3 class="ap-h">{a.h}</h3>
              <p class="ap-p">{a.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Certifications strip -->
  <section class="section-tight certs">
    <div class="container">
      <div class="certs-head">
        <div>
          <p class="eyebrow">Certifications &amp; affiliations</p>
          <h2 class="sec-title">Credentialed to work where it counts</h2>
        </div>
        <a href="/capabilities" class="sec-link">Full capabilities statement →</a>
      </div>
      {CERTIFICATIONS.placeholder && <p class="ph-flag" style="margin-bottom:18px">Placeholder — replace with FDP's actual certifications &amp; logos</p>}
      <div class="cert-row">
        {
          CERTIFICATIONS.items.map((c) => (
            <div class="cert-chip" title={c.name}>
              <span class="cert-abbr">{c.abbr}</span>
              <span class="cert-issuer">{c.issuer}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Team teaser -->
  <section class="section-tight">
    <div class="container team-teaser">
      <div class="tt-copy">
        <p class="eyebrow">Our Team</p>
        <h2 class="sec-title">The people behind the plans</h2>
        <p class="tt-lede">
          Foodservice design is detail work. Meet the designers, project
          managers, and specialists who deliver FDP projects.
        </p>
        <a href="/team" class="btn btn-primary">Meet the team</a>
      </div>
      <div class="tt-faces" aria-hidden="true">
        {
          TEAM.members.slice(0, 4).map((m) => (
            <div class="monogram tt-face"><span>{initials(m.name)}</span></div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Offices -->
  <section class="section">
    <div class="container offices">
      <div class="off-head">
        <p class="eyebrow">Where we are</p>
        <h2 class="sec-title">Two offices, statewide reach</h2>
      </div>
      <div class="off-grid">
        {
          OFFICES.map((o) => (
            <div class="off">
              <h3 class="off-city">{o.city}</h3>
              <p class="off-area">{o.area}</p>
              <a href={o.phoneHref} class="off-phone tabular">{o.phone}</a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    .page-head{padding:clamp(48px,7vw,90px) 0 10px}
    .page-title{font-size:clamp(2.4rem,5vw,3.8rem);font-weight:800;max-width:18ch;margin:16px 0 20px}
    .page-lede{color:var(--ink-soft);max-width:64ch;font-size:1.18rem;line-height:1.6}
    .sec-title{font-size:clamp(1.8rem,3.4vw,2.6rem);font-weight:700;margin-top:8px}
    .sec-link,.sec-link:visited{color:var(--accent-ink);font-family:var(--font-display);font-weight:600;text-decoration:none;white-space:nowrap}
    .sec-link:hover{text-decoration:underline}

    /* Mission */
    .mission{background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:clamp(46px,7vw,84px) 0}
    .mission-head{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:20px}
    .mission-statement{font-family:var(--font-display);font-weight:600;font-size:clamp(1.5rem,3.2vw,2.3rem);line-height:1.3;letter-spacing:-.01em;max-width:24ch;color:var(--ink);text-wrap:balance}
    .values{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:38px}
    .value{border-left:2px solid var(--accent);padding-left:18px}
    .value-h{font-size:1.1rem;font-weight:700;margin-bottom:6px}
    .value-p{color:var(--ink-soft);font-size:.96rem}
    @media (max-width:760px){.values{grid-template-columns:1fr}}

    /* Approach */
    .approach{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    .ap{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:28px 26px;display:flex;flex-direction:column;gap:10px}
    .ap-n{font-family:var(--font-mono);font-size:13px;color:var(--accent);font-weight:600}
    .ap-h{font-size:1.35rem;font-weight:700}
    .ap-p{color:var(--ink-soft);font-size:.98rem}
    @media (max-width:860px){.approach{grid-template-columns:1fr}}

    /* Certifications */
    .certs{background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .certs-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:22px}
    .cert-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
    .cert-chip{display:flex;flex-direction:column;gap:4px;background:var(--ground);border:1px solid var(--line);border-radius:var(--radius);padding:18px 20px}
    .cert-abbr{font-family:var(--font-display);font-weight:800;font-size:1.4rem;color:var(--accent)}
    .cert-issuer{font-size:.82rem;color:var(--muted)}
    @media (max-width:760px){.cert-row{grid-template-columns:1fr 1fr}}

    /* Team teaser */
    .team-teaser{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:center}
    .tt-lede{color:var(--ink-soft);font-size:1.05rem;max-width:46ch;margin:14px 0 22px}
    .tt-faces{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    .tt-face{font-size:1.6rem}
    @media (max-width:760px){.team-teaser{grid-template-columns:1fr}.tt-faces{max-width:280px}}

    /* Offices */
    .off-head{margin-bottom:36px}
    .off-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:760px}
    .off{background:var(--paper);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:var(--radius);padding:28px 30px}
    .off-city{font-size:1.6rem;font-weight:800}
    .off-area{color:var(--muted);margin:2px 0 14px}
    .off-phone{font-family:var(--font-mono);color:var(--steel-ink);text-decoration:none;font-size:1.05rem;font-weight:500}
    .off-phone:hover{color:var(--accent)}
    @media (max-width:560px){.off-grid{grid-template-columns:1fr}}
  </style>
</BaseLayout>
