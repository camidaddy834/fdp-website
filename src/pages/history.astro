---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { HISTORY, FOUNDER } from "../data/company";
import { SITE } from "../data/site";

const { intro, milestones, headline } = HISTORY;

// Auto-discover archive media in /public/history (scanned at build). Web-ready
// full views + thumbnails are produced from history-originals/ by
// `npm run history:build`; the page just lists whatever full-view JPGs exist.
type Media = { src: string; thumb: string };
let media: Media[] = [];
try {
  media = fs
    .readdirSync(path.resolve("public/history"))
    .filter((f) => /\.jpe?g$/i.test(f))
    .sort()
    .map((f) => ({
      src: encodeURI(`/history/${f}`),
      thumb: encodeURI(`/history/thumbs/${f}`),
    }));
} catch {
  /* folder not present yet → placeholder tiles below */
}
const archiveTiles = media.length > 0 ? media : Array.from({ length: 6 });
---

<BaseLayout
  title="History"
  description={`${headline} — the story of FDP, built on 100+ years of combined food service design experience across three predecessor firms.`}
>
  <section class="page-head">
    <div class="container">
      <p class="crumb"><a href="/about">Who We Are</a> <span>/</span> History</p>
      <p class="eyebrow">Our History</p>
      <h1 class="page-title">{headline}</h1>
      <p class="page-lede">{intro}</p>
      {HISTORY.placeholder && (
        <p class="ph-flag" style="margin-top:22px">
          Placeholder — replace with FDP's real history, dates, and archive images
        </p>
      )}
    </div>
  </section>

  <!-- Timeline -->
  <section class="section-tight">
    <div class="container">
      <ol class="timeline">
        {
          milestones.map((m) => (
            <li class="tl-item">
              <div class="tl-year tabular">{m.year}</div>
              <div class="tl-body">
                <h2 class="tl-title">{m.title}</h2>
                <p class="tl-text">{m.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- From the founder -->
  <section class="section-tight founder">
    <div class="container">
      <div class="fd-grid">
        <aside class="fd-card">
          <img
            class="fd-portrait"
            src={FOUNDER.portrait}
            alt={`Portrait of ${FOUNDER.name}`}
            width="358"
            height="348"
            loading="lazy"
          />
          <p class="fd-name">{FOUNDER.name}</p>
          <p class="fd-role">{FOUNDER.role}</p>
        </aside>
        <div class="fd-body">
          <p class="eyebrow">{FOUNDER.eyebrow}</p>
          <h2 class="fd-title">
            &ldquo;{FOUNDER.articleTitle}&rdquo;
          </h2>
          <p class="fd-meta">{FOUNDER.articleMeta}</p>
          <p class="fd-text">{FOUNDER.blurb}</p>
          <p class="fd-pages-label">Read the original article</p>
          <div class="fd-reader fd-gallery">
            <button class="fd-nav fd-prev" type="button" aria-label="Previous page">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <ul class="fd-track">
              {
                FOUNDER.pages.map((p, i) => (
                  <li class="fd-slide">
                    <button
                      class="fd-zoom"
                      type="button"
                      data-src={p.src}
                      aria-label={`Enlarge page ${i + 1} of ${FOUNDER.pages.length}`}
                    >
                      <img
                        src={p.src}
                        alt={`“${FOUNDER.articleTitle}” — page ${i + 1} of ${FOUNDER.pages.length}`}
                        loading="lazy"
                      />
                      <span class="fd-zoom-hint" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                      </span>
                    </button>
                  </li>
                ))
              }
            </ul>
            <button class="fd-nav fd-next" type="button" aria-label="Next page">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Built-work photo gallery -->
      <div class="fd-work">
        <h3 class="fd-work-title">{FOUNDER.workHeading}</h3>
        <p class="fd-work-blurb">{FOUNDER.workBlurb}</p>
        <ul class="fd-work-grid fd-gallery">
          {
            FOUNDER.work.map((p, i) => (
              <li class="fd-work-item">
                <button
                  class="fd-zoom"
                  type="button"
                  data-src={p.src}
                  aria-label={`Enlarge photograph ${i + 1} of ${FOUNDER.work.length}`}
                >
                  <img src={p.thumb} alt={`H. G. Rice & Company built work, photograph ${i + 1}`} loading="lazy" />
                  <span class="fd-zoom-hint" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Lightbox (click-to-zoom reader) -->
    <div
      class="fdlb"
      id="fdLightbox"
      hidden
      role="dialog"
      aria-modal="true"
      aria-label={`“${FOUNDER.articleTitle}” — article viewer`}
    >
      <button class="fdlb-btn fdlb-close" type="button" aria-label="Close viewer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      </button>
      <button class="fdlb-btn fdlb-prev" type="button" aria-label="Previous page">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="fdlb-stage">
        <img class="fdlb-img" src="" alt="" />
      </div>
      <button class="fdlb-btn fdlb-next" type="button" aria-label="Next page">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <p class="fdlb-counter"><span class="fdlb-cur">1</span> / <span class="fdlb-total">{FOUNDER.pages.length}</span></p>
    </div>
  </section>

  <script>
    // Horizontal article reader: arrow buttons scroll one page at a time;
    // native swipe / trackpad / scrollbar also work. Buttons disable at the ends.
    document.querySelectorAll<HTMLElement>(".fd-reader").forEach((reader) => {
      const track = reader.querySelector<HTMLElement>(".fd-track");
      const prev = reader.querySelector<HTMLButtonElement>(".fd-prev");
      const next = reader.querySelector<HTMLButtonElement>(".fd-next");
      if (!track || !prev || !next) return;

      const step = () => {
        const slide = track.querySelector<HTMLElement>(".fd-slide");
        const gap = parseFloat(getComputedStyle(track).columnGap || "16") || 16;
        return slide ? slide.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
      };
      prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
      next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));

      const update = () => {
        const max = track.scrollWidth - track.clientWidth - 2;
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= max;
      };
      track.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      update();
    });

    // Click-to-zoom lightbox — shared across every .fd-gallery on the page.
    (() => {
      const lb = document.getElementById("fdLightbox");
      if (!lb) return;
      const img = lb.querySelector<HTMLImageElement>(".fdlb-img");
      const counter = lb.querySelector<HTMLElement>(".fdlb-cur");
      const total = lb.querySelector<HTMLElement>(".fdlb-total");
      const btnClose = lb.querySelector<HTMLButtonElement>(".fdlb-close");
      const btnPrev = lb.querySelector<HTMLButtonElement>(".fdlb-prev");
      const btnNext = lb.querySelector<HTMLButtonElement>(".fdlb-next");
      const galleries = Array.from(document.querySelectorAll<HTMLElement>(".fd-gallery"));
      if (!img || !galleries.length) return;

      let sources: string[] = [];
      let index = 0;
      let lastFocus: HTMLElement | null = null;

      const show = (i: number) => {
        if (!sources.length) return;
        index = (i + sources.length) % sources.length;
        img.classList.remove("zoomed");
        img.src = sources[index];
        img.alt = `Image ${index + 1} of ${sources.length}`;
        if (counter) counter.textContent = String(index + 1);
        if (total) total.textContent = String(sources.length);
      };

      const open = (set: string[], i: number) => {
        sources = set;
        lastFocus = document.activeElement as HTMLElement;
        show(i);
        lb.hidden = false;
        document.body.style.overflow = "hidden";
        btnClose?.focus();
      };

      const close = () => {
        lb.hidden = true;
        document.body.style.overflow = "";
        lastFocus?.focus();
      };

      galleries.forEach((gallery) => {
        const zooms = Array.from(gallery.querySelectorAll<HTMLButtonElement>(".fd-zoom"));
        const set = zooms.map((z) => z.dataset.src || "");
        zooms.forEach((z, i) => z.addEventListener("click", () => open(set, i)));
      });
      btnClose?.addEventListener("click", close);
      btnPrev?.addEventListener("click", () => show(index - 1));
      btnNext?.addEventListener("click", () => show(index + 1));

      // Click backdrop (not the image or a control) closes
      lb.addEventListener("click", (e) => {
        if (e.target === lb || e.target === lb.querySelector(".fdlb-stage")) close();
      });

      // Toggle actual-size zoom for reading fine print
      img.addEventListener("click", () => img.classList.toggle("zoomed"));

      document.addEventListener("keydown", (e) => {
        if (lb.hidden) return;
        if (e.key === "Escape") close();
        else if (e.key === "ArrowLeft") show(index - 1);
        else if (e.key === "ArrowRight") show(index + 1);
      });
    })();
  </script>

  <!-- Archive -->
  <section class="section-tight archive">
    <div class="container">
      <div class="sec-head">
        <div>
          <p class="eyebrow">From the archive</p>
          <h2 class="sec-title">Original drawings &amp; media</h2>
        </div>
      </div>
      <p class="archive-note">
        Decades of original drawings, plans, and photography from the FDP
        archive. Select an item to open the full-resolution scan.
      </p>
      <div class="archive-grid">
        {
          archiveTiles.map((item: any) =>
            item?.src ? (
              <a class="arch" href={item.src} target="_blank" rel="noopener">
                <img src={item.thumb} alt="FDP historical drawing" loading="lazy" />
              </a>
            ) : (
              <div class="arch arch-ph" aria-hidden="true">
                <span class="arch-mark">FDP</span>
              </div>
            ),
          )
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow on-dark">Carrying it forward</p>
        <h2 class="cta-title">Nearly six decades of built work — and counting.</h2>
        <p class="cta-lede">
          Have a facility on the drawing board? Proposals go to{" "}
          <a href={`mailto:${SITE.proposalEmail}`}>{SITE.proposalEmail}</a>.
        </p>
      </div>
      <a href="/contact#proposal-form" class="btn btn-primary cta-btn">Request a proposal</a>
    </div>
  </section>

  <style>
    .page-head{padding:clamp(48px,7vw,86px) 0 10px}
    .crumb{font-family:var(--font-mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
    .crumb a{color:var(--accent-ink);text-decoration:none}
    .crumb a:hover{text-decoration:underline}
    .crumb span{margin:0 6px;opacity:.5}
    .page-title{font-size:clamp(2.4rem,5vw,3.6rem);font-weight:800;margin:14px 0 16px}
    .page-lede{color:var(--ink-soft);max-width:60ch;font-size:1.1rem}

    /* Timeline */
    .timeline{list-style:none;margin:0;padding:0;max-width:760px}
    .tl-item{
      display:grid;grid-template-columns:120px 1fr;gap:clamp(18px,3vw,36px);
      padding:26px 0;border-top:1px solid var(--line);position:relative;
    }
    .tl-item:first-child{border-top:none}
    .tl-year{
      font-family:var(--font-display);font-weight:800;font-size:1.35rem;color:var(--accent);
      position:relative;padding-left:20px;
    }
    .tl-year::before{
      content:"";position:absolute;left:0;top:.4em;width:9px;height:9px;border-radius:50%;
      background:var(--accent);
    }
    .tl-title{font-family:var(--font-display);font-weight:700;font-size:1.2rem;margin:0 0 6px}
    .tl-text{color:var(--ink-soft);font-size:1rem;line-height:1.6;max-width:52ch}

    /* From the founder */
    .founder{border-top:1px solid var(--line)}
    .fd-grid{display:grid;grid-template-columns:260px 1fr;gap:clamp(28px,5vw,56px);align-items:start}
    .fd-card{
      position:sticky;top:96px;
      border:1px solid var(--line);border-radius:var(--radius-lg);
      background:var(--steel-wash);padding:18px;text-align:center;
    }
    .fd-portrait{
      width:100%;height:auto;display:block;border-radius:var(--radius);
      filter:grayscale(1) contrast(1.02);background:#e9ebe6;
    }
    .fd-name{font-family:var(--font-display);font-weight:800;font-size:1.12rem;margin:14px 0 2px}
    .fd-role{font-family:var(--font-mono);font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
    .fd-title{font-size:clamp(1.5rem,3vw,2rem);font-weight:800;margin:6px 0 4px;line-height:1.15}
    .fd-meta{font-family:var(--font-mono);font-size:12px;letter-spacing:.04em;color:var(--muted);margin-bottom:16px}
    .fd-text{color:var(--ink-soft);font-size:1.02rem;line-height:1.7;max-width:62ch}
    .fd-pages-label{
      font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;
      color:var(--muted);margin:22px 0 10px;
    }
    /* Horizontal article reader (scroll-snap carousel) */
    .fd-reader{position:relative}
    .fd-track{
      list-style:none;margin:0;padding:4px 2px 14px;
      display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;
      scroll-behavior:smooth;scrollbar-width:thin;scrollbar-color:var(--line-strong) transparent;
      overscroll-behavior-x:contain;
    }
    .fd-track::-webkit-scrollbar{height:8px}
    .fd-track::-webkit-scrollbar-thumb{background:var(--line-strong);border-radius:8px}
    .fd-slide{
      flex:0 0 auto;height:clamp(360px,62vh,600px);scroll-snap-align:center;
      border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#f4f5f3;
      box-shadow:var(--shadow-sm);
    }
    .fd-slide img{height:100%;width:auto;display:block}
    .fd-zoom{
      display:block;height:100%;padding:0;border:0;background:none;cursor:zoom-in;
      position:relative;
    }
    .fd-zoom-hint{
      position:absolute;bottom:10px;right:10px;width:34px;height:34px;border-radius:50%;
      display:grid;place-items:center;color:#fff;background:rgba(20,25,32,.72);
      opacity:0;transform:translateY(4px);transition:opacity .16s ease, transform .16s ease;
      backdrop-filter:blur(3px);pointer-events:none;
    }
    .fd-zoom-hint svg{width:18px;height:18px}
    .fd-zoom:hover .fd-zoom-hint,
    .fd-zoom:focus-visible .fd-zoom-hint{opacity:1;transform:translateY(0)}

    /* Built-work photo gallery */
    .fd-work{margin-top:clamp(40px,6vw,64px);border-top:1px solid var(--line);padding-top:clamp(28px,4vw,44px)}
    .fd-work-title{font-size:clamp(1.4rem,2.6vw,1.9rem);font-weight:800;margin:0 0 8px}
    .fd-work-blurb{color:var(--ink-soft);max-width:66ch;margin:0 0 22px;font-size:1.02rem;line-height:1.6}
    .fd-work-grid{list-style:none;margin:0;padding:0;column-count:3;column-gap:14px}
    .fd-work-item{margin:0 0 14px;break-inside:avoid;-webkit-column-break-inside:avoid}
    .fd-work-item .fd-zoom{
      height:auto;width:100%;border-radius:10px;overflow:hidden;
      border:1px solid var(--line);background:#f4f5f3;box-shadow:var(--shadow-sm);
      transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }
    .fd-work-item .fd-zoom:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg);border-color:var(--line-strong)}
    .fd-work-item .fd-zoom img{width:100%;height:auto;display:block}
    @media (max-width:860px){.fd-work-grid{column-count:2}}
    @media (max-width:520px){.fd-work-grid{column-count:1}}
    .fd-nav{
      position:absolute;top:calc(50% - 7px);transform:translateY(-50%);z-index:3;
      width:44px;height:44px;border-radius:50%;border:1px solid var(--line-strong);
      background:rgba(255,255,255,.94);color:var(--accent-ink);
      display:grid;place-items:center;cursor:pointer;box-shadow:var(--shadow-lg);
      transition:background .15s ease, opacity .15s ease;
    }
    .fd-nav svg{width:22px;height:22px}
    .fd-nav:hover{background:#fff}
    .fd-nav:disabled{opacity:.3;cursor:default}
    .fd-prev{left:-10px}
    .fd-next{right:-10px}
    @media (max-width:480px){
      .fd-prev{left:2px}
      .fd-next{right:2px}
    }

    /* Lightbox */
    .fdlb{
      position:fixed;inset:0;z-index:200;
      display:flex;align-items:center;justify-content:center;
      padding:clamp(14px,3vw,44px);
      background:rgba(12,16,22,.88);backdrop-filter:blur(4px);
      animation:fdlb-in .18s ease;
    }
    .fdlb[hidden]{display:none}
    @keyframes fdlb-in{from{opacity:0}to{opacity:1}}
    .fdlb-stage{
      max-width:100%;max-height:100%;overflow:auto;
      display:flex;align-items:center;justify-content:center;
      -webkit-overflow-scrolling:touch;
    }
    .fdlb-img{
      max-width:100%;max-height:calc(100vh - 88px);width:auto;height:auto;display:block;
      border-radius:6px;background:#f4f5f3;box-shadow:0 24px 60px -16px rgba(0,0,0,.6);
      cursor:zoom-in;
    }
    .fdlb-img.zoomed{max-width:none;max-height:none;width:auto;height:auto;cursor:zoom-out}
    .fdlb-btn{
      position:fixed;z-index:2;width:46px;height:46px;border-radius:50%;
      border:1px solid rgba(255,255,255,.28);background:rgba(28,34,42,.72);color:#fff;
      display:grid;place-items:center;cursor:pointer;
      transition:background .15s ease, border-color .15s ease;
    }
    .fdlb-btn svg{width:24px;height:24px}
    .fdlb-btn:hover{background:rgba(44,52,62,.95);border-color:rgba(255,255,255,.5)}
    .fdlb-close{top:16px;right:16px}
    .fdlb-prev{top:50%;left:16px;transform:translateY(-50%)}
    .fdlb-next{top:50%;right:16px;transform:translateY(-50%)}
    .fdlb-counter{
      position:fixed;bottom:16px;left:50%;transform:translateX(-50%);
      font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;color:rgba(255,255,255,.82);
      background:rgba(28,34,42,.72);padding:5px 12px;border-radius:999px;
    }
    @media (max-width:480px){
      .fdlb-prev{left:6px}
      .fdlb-next{right:6px}
    }
    @media (prefers-reduced-motion:reduce){
      .fdlb{animation:none}
    }

    @media (max-width:760px){
      .fd-grid{grid-template-columns:1fr}
      .fd-card{position:static;max-width:300px;margin:0 auto}
    }

    /* Archive */
    .sec-head{margin-bottom:14px}
    .sec-title{font-size:clamp(1.5rem,3vw,2rem);font-weight:800;margin-top:4px}
    .archive-note{color:var(--ink-soft);max-width:56ch;margin-bottom:26px}
    .archive-note code{font-family:var(--font-mono);font-size:.85em;background:var(--steel-wash);padding:2px 6px;border-radius:5px}
    /* Masonry via CSS columns so each scan shows at its own aspect ratio —
       no white letterbox bars, no cropping of the drawing. */
    .archive-grid{column-count:3;column-gap:18px}
    .arch{
      position:relative;display:block;margin:0 0 18px;break-inside:avoid;-webkit-column-break-inside:avoid;
      border-radius:var(--radius-lg);overflow:hidden;
      border:1px solid var(--line);background:#f4f5f3;
      transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }
    .arch:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg);border-color:var(--line-strong)}
    .arch img{width:100%;height:auto;display:block}
    .arch-badge{
      position:absolute;top:10px;right:10px;
      font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.08em;
      background:rgba(20,25,32,.78);color:#fff;padding:4px 8px;border-radius:6px;backdrop-filter:blur(4px);
    }
    .arch-ph{
      aspect-ratio:4/3;display:grid;place-items:center;
      background:
        radial-gradient(120% 120% at 30% 20%, #2c4d84 0%, transparent 55%),
        radial-gradient(120% 120% at 80% 90%, #9aa3b3 0%, transparent 60%),
        var(--ink-900);
    }
    .arch-mark{font-family:var(--font-display);font-weight:800;font-size:1.7rem;letter-spacing:.12em;color:rgba(255,255,255,.26)}

    /* CTA (mirrors the homepage CTA) */
    .cta{background:var(--ink-900);color:#fff;margin-top:clamp(40px,6vw,72px)}
    .cta-inner{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:clamp(44px,6vw,72px) 0;flex-wrap:wrap}
    .cta-title{font-size:clamp(1.7rem,3.2vw,2.4rem);font-weight:800;color:#fff;max-width:20ch}
    .cta-lede{color:#b8c0c8;margin-top:10px;max-width:44ch}
    .cta-lede a{color:var(--on-dark-accent)}
    .cta-btn{background:#fff;color:var(--accent)}
    .cta-btn:hover{background:var(--steel-wash)}

