---
import BaseLayout from "../layouts/BaseLayout.astro";
import { OFFICES, SITE } from "../data/site";
import { VERTICAL_META } from "../data/site";
import { VERTICALS } from "../content.config";
---

<BaseLayout title="Contact" description="Request a proposal or reach an FDP office in Dallas or Houston.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1 class="page-title">How can we help?</h1>
      <p class="page-lede">
        Send us the scope and we'll tell you how we'd approach it. Prefer the
        phone? Reach either office directly below.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="proposal-cta">
        <div class="pc-text">
          <p class="pc-eyebrow">Prefer email?</p>
          <p class="pc-line">
            Send your proposal request straight to our team &mdash; or use the
            form below and we&rsquo;ll get right back to you.
          </p>
        </div>
        <a href={`mailto:${SITE.proposalEmail}`} class="btn btn-primary pc-btn">
          {SITE.proposalEmail}
        </a>
      </div>
    </div>
    <div class="container contact-grid">
      <!-- Posts JSON to the Netlify function at /api/proposal (see netlify.toml) -->
      <form
        id="proposal-form"
        class="form"
        method="POST"
        action="/api/proposal"
        aria-label="Proposal request"
      >
        <!-- Honeypot: hidden from people, tempting to bots. Submissions with
             this filled are silently dropped by the function. -->
        <p class="hp" aria-hidden="true">
          <label>Leave this field empty
            <input type="text" name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>
        <div class="row">
          <label>Name<input type="text" name="name" required autocomplete="name" /></label>
          <label>Organization<input type="text" name="org" autocomplete="organization" /></label>
        </div>
        <div class="row">
          <label>Email<input type="email" name="email" required autocomplete="email" /></label>
          <label>Phone<input type="tel" name="phone" autocomplete="tel" /></label>
        </div>
        <label>Project type
          <select name="sector">
            <option value="">Select a sector…</option>
            {VERTICALS.map((v) => <option value={v}>{VERTICAL_META[v].label}</option>)}
          </select>
        </label>
        <label>Tell us about the project
          <textarea name="message" rows="5" placeholder="Scope, location, timeline, square footage…"></textarea>
        </label>
        <button type="submit" class="btn btn-primary form-submit">Request a proposal</button>
        <p class="form-status" role="status" aria-live="polite" hidden></p>
      </form>

      <!-- Offices -->
      <aside class="contact-aside">
        <div class="ca-block">
          <h2 class="ca-h">Proposals</h2>
          <a href={`mailto:${SITE.proposalEmail}`} class="ca-mail">{SITE.proposalEmail}</a>
        </div>
        <div class="ca-block">
          <h2 class="ca-h">Offices</h2>
          {
            OFFICES.map((o) => (
              <div class="ca-office">
                <span class="ca-city">{o.city} <span class="ca-area">({o.area})</span></span>
                <span class="ca-addr">{o.address}</span>
                <a href={o.phoneHref} class="ca-phone tabular">{o.phone}</a>
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </section>

  <style>
    .page-head{padding:clamp(48px,7vw,86px) 0 10px}
    .page-title{font-size:clamp(2.3rem,5vw,3.6rem);font-weight:800;margin:16px 0 16px}
    .page-lede{color:var(--ink-soft);max-width:56ch;font-size:1.12rem}
    .proposal-cta{
      display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;
      background:var(--accent-wash);border:1px solid color-mix(in srgb,var(--accent) 22%,transparent);
      border-radius:var(--radius-lg);padding:20px 24px;margin-bottom:34px;
    }
    .pc-eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-ink);font-weight:600;margin-bottom:5px}
    .pc-line{color:var(--ink-soft);font-size:1rem;max-width:52ch}
    .pc-btn{white-space:nowrap;font-family:var(--font-mono);font-size:.95rem}
    @media (max-width:560px){.proposal-cta{flex-direction:column;align-items:flex-start}.pc-btn{width:100%;justify-content:center}}
    .contact-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:clamp(30px,5vw,60px);align-items:start}
    .form{display:flex;flex-direction:column;gap:16px;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius-lg);padding:clamp(24px,3vw,36px);box-shadow:var(--shadow-sm)}
    .row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    label{display:flex;flex-direction:column;gap:6px;font-family:var(--font-display);font-weight:600;font-size:.9rem;color:var(--ink)}
    input,select,textarea{
      font-family:var(--font-body);font-size:1rem;color:var(--ink);
      background:var(--ground);border:1px solid var(--line-strong);border-radius:9px;padding:11px 13px;width:100%;
    }
    input:focus,select:focus,textarea:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:var(--accent)}
    textarea{resize:vertical}
    .form-submit{margin-top:6px;align-self:flex-start}
    /* Honeypot — visually hidden but still reachable by bots (not display:none,
       which some bots skip). */
    .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
    .form-status{font-size:.92rem;line-height:1.5;margin:0;padding:11px 14px;border-radius:9px}
    .form-status[data-state="error"]{color:#8a1c1c;background:#fdecec;border:1px solid #f4c7c7}
    .form-status a{color:inherit;font-weight:600}
    .contact-aside{display:flex;flex-direction:column;gap:30px}
    .ca-h{font-family:var(--font-display);font-size:.82rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
    .ca-mail{font-family:var(--font-mono);color:var(--accent-ink);text-decoration:none;font-size:1rem}
    .ca-mail:hover{text-decoration:underline}
    .ca-office{display:flex;flex-direction:column;padding:14px 0;border-bottom:1px solid var(--line)}
    .ca-office:last-child{border-bottom:none}
    .ca-city{font-family:var(--font-display);font-weight:700;font-size:1.1rem}
    .ca-area{color:var(--muted);font-weight:400;font-size:.9rem}
    .ca-addr{color:var(--ink-soft);font-size:.9rem;margin-top:4px}
    .ca-phone{font-family:var(--font-mono);color:var(--steel-ink);text-decoration:none;margin-top:3px}
    .ca-phone:hover{color:var(--accent)}
    @media (max-width:820px){.contact-grid{grid-template-columns:1fr}.row{grid-template-columns:1fr}}
  </style>

  <script define:vars={{ proposalEmail: SITE.proposalEmail }}>
    const form = document.getElementById("proposal-form");
    if (form) {
      const btn = form.querySelector(".form-submit");
      const status = form.querySelector(".form-status");
      let started = false;

      // GTM funnel: push once when the visitor first engages a field. A GTM
      // trigger on this custom event can forward it to GA4 as form_start.
      form.addEventListener(
        "focusin",
        () => {
          if (started) return;
          started = true;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: "form_start", form_id: "proposal" });
        },
        { once: false },
      );

      const showError = (msg) => {
        status.hidden = false;
        status.dataset.state = "error";
        status.innerHTML =
          msg + ` You can also email <a href="mailto:${proposalEmail}">${proposalEmail}</a>.`;
      };

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;

        const payload = Object.fromEntries(new FormData(form).entries());
        const original = btn.textContent;
        btn.disabled = true;
        btn.textContent = "Sending…";
        status.hidden = true;
        delete status.dataset.state;

        try {
          const res = await fetch("/api/proposal", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const out = await res.json().catch(() => ({}));
          if (res.ok && out.ok) {
            window.location.assign("/contact/thanks/");
            return;
          }
          throw new Error(out.error || "Something went wrong.");
        } catch (err) {
          showError(err && err.message ? err.message : "Something went wrong.");
          btn.disabled = false;
          btn.textContent = original;
        }
      });
    }
  </script>
</BaseLayout>
