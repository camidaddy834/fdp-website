---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TESTIMONIALS } from "../data/company";
import { SITE } from "../data/site";

const testimonials = TESTIMONIALS.filter((t) => t.approved);
---

<BaseLayout
  title="Testimonials"
  description="What school nutrition directors and child nutrition teams say about working with FDP on kitchen design, renovations, and new school construction."
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Testimonials</p>
      <h1 class="page-title">In their words</h1>
      <p class="page-lede">
        Many of our K-12 partners have worked with FDP for a decade or more,
        across bond programs, new schools, renovations, and equipment projects.
        Here&rsquo;s what their nutrition leaders say about the work.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      {testimonials.length > 0 && (
        <div class="tmon-grid">
          {testimonials.map((t) => (
            <figure class="tmon-card">
              <blockquote class="tmon-quote">{t.quote}</blockquote>
              <figcaption class="tmon-cite">
                <div class="tmon-cite-text">
                  <span class="tmon-name">{t.name}</span>
                  <span class="tmon-role">{t.title}</span>
                </div>
                {t.logo ? (
                  <img class="tmon-logo" src={t.logo} alt={`${t.org} logo`} width="120" height="46" loading="lazy" />
                ) : (
                  <span class="tmon-chip">{t.org}</span>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow on-dark">Start a project</p>
        <h2 class="cta-title">Have a facility on the drawing board?</h2>
        <p class="cta-lede">
          Send us the scope and we&rsquo;ll tell you how we&rsquo;d approach it.
          Proposals go to <a href={`mailto:${SITE.proposalEmail}`}>{SITE.proposalEmail}</a>.
        </p>
      </div>
      <a href="/contact#proposal-form" class="btn btn-ghost on-dark">Request a proposal</a>
    </div>
  </section>

  <style>
    .page-head{padding:clamp(48px,7vw,90px) 0 10px}
    .page-title{font-size:clamp(2.4rem,5vw,3.8rem);font-weight:800;max-width:18ch;margin:16px 0 20px}
    .page-lede{color:var(--ink-soft);max-width:64ch;font-size:1.18rem;line-height:1.6}

    /* Testimonials */
    .tmon-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}
    .tmon-card{
      position:relative;display:flex;flex-direction:column;
      background:var(--paper);border:1px solid var(--line);border-radius:var(--radius-lg);
      padding:30px 32px 26px;box-shadow:var(--shadow-sm);
    }
    .tmon-card::before{
      content:"\201C";position:absolute;top:10px;left:20px;z-index:0;
      font-family:var(--font-display);font-weight:800;font-size:4.2rem;line-height:1;color:var(--accent-wash);
    }
    .tmon-quote{position:relative;z-index:1;margin:0 0 20px;font-size:1.04rem;line-height:1.65;color:var(--ink-soft)}
    .tmon-cite{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:auto;border-top:1px solid var(--line);padding-top:14px}
    .tmon-cite-text{display:flex;flex-direction:column;min-width:0}
    .tmon-name{font-family:var(--font-display);font-weight:700;color:var(--ink);font-size:1.02rem}
    .tmon-role{font-size:.9rem;color:var(--ink-soft);margin-top:2px}
    .tmon-logo{flex-shrink:0;height:46px;width:auto;max-width:120px;object-fit:contain;object-position:right center}
    .tmon-chip{flex-shrink:0;font-family:var(--font-mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;line-height:1;color:var(--accent-ink);background:var(--accent-wash);border:1px solid color-mix(in srgb, var(--accent) 18%, transparent);padding:8px 12px;border-radius:8px;white-space:nowrap}
    @media (max-width:760px){.tmon-grid{grid-template-columns:1fr}}

    /* CTA */
    .cta{background:var(--ink-900);color:#fff;margin-top:clamp(50px,7vw,90px)}
    .cta-inner{display:flex;justify-content:space-between;align-items:center;gap:36px;padding:clamp(46px,7vw,80px) 0;flex-wrap:wrap}
    .cta-title{font-size:clamp(1.8rem,3.4vw,2.6rem);font-weight:800;color:#fff;margin:12px 0 12px}
    .cta-lede{color:#b8c0c8;max-width:52ch}
    .cta-lede a{color:var(--on-dark-accent)}
  </style>
</BaseLayout>
