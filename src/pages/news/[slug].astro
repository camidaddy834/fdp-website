---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("news")).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const fmtDate = (dt: Date) =>
  dt.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={d.title} description={d.excerpt ?? d.title}>
  <article class="post">
    <header class="post-head">
      <div class="container">
        <p class="crumb"><a href="/news">News</a> <span>/</span> {fmtDate(d.date)}</p>
        <h1 class="post-title">{d.title}</h1>
        <p class="post-meta">
          By {d.author} · <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
        </p>
      </div>
    </header>

    <div class="container">
      {
        d.heroImage && (
          <img class="post-hero" src={d.heroImage} alt={d.title} />
        )
      }
    </div>

    <div class="container post-body">
      <div class="prose">
        <Content />
      </div>
      {
        d.originalUrl && (
          <p class="post-orig">
            <a href={d.originalUrl} target="_blank" rel="noopener">
              View the original post ↗
            </a>
          </p>
        )
      }
      <p class="post-back"><a href="/news">← All news</a></p>
    </div>
  </article>

  <style>
    .post-head{padding:clamp(44px,6vw,78px) 0 24px}
    .crumb{font-family:var(--font-mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
    .crumb a{color:var(--accent-ink);text-decoration:none}
    .crumb a:hover{text-decoration:underline}
    .crumb span{margin:0 6px;opacity:.5}
    .post-title{font-family:var(--font-display);font-weight:800;font-size:clamp(2rem,4.5vw,3.2rem);line-height:1.08;letter-spacing:-.02em;max-width:20ch;margin:0 0 14px}
    .post-meta{font-family:var(--font-mono);font-size:12.5px;color:var(--muted)}

    .post-hero{width:100%;max-height:520px;object-fit:cover;border-radius:var(--radius-lg);box-shadow:var(--shadow)}

    .post-body{padding:clamp(30px,5vw,52px) 0 clamp(50px,7vw,90px)}
    .prose{max-width:68ch;font-size:1.15rem;line-height:1.75;color:var(--ink-soft)}
    .prose :global(p){margin:0 0 1.1rem}
    .prose :global(a){color:var(--accent-ink)}
    .post-orig{margin-top:20px}
    .post-orig a{font-family:var(--font-display);font-weight:600;color:var(--accent-ink);text-decoration:none;font-size:.98rem}
    .post-orig a:hover{text-decoration:underline}
    .post-back{margin-top:30px;padding-top:20px;border-top:1px solid var(--line)}
    .post-back a{font-family:var(--font-display);font-weight:600;color:var(--steel-ink);text-decoration:none}
    .post-back a:hover{color:var(--accent)}
  </style>
</BaseLayout>
