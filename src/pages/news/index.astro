---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("news"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title="News" description="Project announcements, features, and updates from Foodservice Design Professionals.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">News</p>
      <h1 class="page-title">News &amp; features</h1>
      <p class="page-lede">
        Project announcements, magazine features, and notes from the studio —
        including an archive of highlights from our earlier work.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="news-grid">
        {
          posts.map((p) => (
            <a href={`/news/${p.id}/`} class="ncard">
              <div class="ncard-media">
                {
                  p.data.heroImage ? (
                    <img src={p.data.heroImage} alt={p.data.title} loading="lazy" />
                  ) : (
                    <div class="ncard-ph" aria-hidden="true"><span>FDP</span></div>
                  )
                }
              </div>
              <div class="ncard-body">
                <time class="ncard-date" datetime={p.data.date.toISOString()}>
                  {fmtDate(p.data.date)}
                </time>
                <h2 class="ncard-title">{p.data.title}</h2>
                {p.data.excerpt && <p class="ncard-ex">{p.data.excerpt}</p>}
                <span class="ncard-go">Read more →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    .page-head{padding:clamp(48px,7vw,86px) 0 10px}
    .page-title{font-size:clamp(2.4rem,5vw,3.6rem);font-weight:800;margin:16px 0 16px}
    .page-lede{color:var(--ink-soft);max-width:60ch;font-size:1.12rem}

    .news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    .ncard{
      display:flex;flex-direction:column;text-decoration:none;color:inherit;
      background:var(--paper);border:1px solid var(--line);border-radius:var(--radius-lg);
      overflow:hidden;box-shadow:var(--shadow-sm);
      transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }
    .ncard:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:var(--line-strong)}
    .ncard-media{aspect-ratio:3/2;overflow:hidden;background:var(--ink-900)}
    .ncard-media img{width:100%;height:100%;object-fit:cover;transition:transform .3s ease}
    .ncard:hover .ncard-media img{transform:scale(1.04)}
    .ncard-ph{
      width:100%;height:100%;display:grid;place-items:center;
      background:
        radial-gradient(120% 120% at 30% 20%, #2c4d84 0%, transparent 55%),
        radial-gradient(120% 120% at 80% 90%, #9aa3b3 0%, transparent 60%),
        var(--ink-900);
    }
    .ncard-ph span{font-family:var(--font-display);font-weight:800;font-size:1.8rem;letter-spacing:.12em;color:rgba(255,255,255,.28)}
    .ncard-body{padding:20px 22px 22px;display:flex;flex-direction:column;gap:9px;flex:1}
    .ncard-date{font-family:var(--font-mono);font-size:11.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--accent-ink);font-weight:500}
    .ncard-title{font-size:1.2rem;font-weight:700;line-height:1.2}
    .ncard-ex{color:var(--ink-soft);font-size:.94rem;line-height:1.5;flex:1}
    .ncard-go{font-family:var(--font-display);font-weight:600;font-size:.9rem;color:var(--steel-ink);margin-top:4px}
    @media (max-width:920px){.news-grid{grid-template-columns:1fr 1fr}}
    @media (max-width:600px){.news-grid{grid-template-columns:1fr}}
  </style>
</BaseLayout>
