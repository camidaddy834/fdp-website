---
import "../styles/global.css";
import { SITE, NAV, OFFICES } from "../data/site";
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
  title?: string;
  description?: string;
  /** Page-specific social preview image (absolute path, e.g. "/news/foo.jpg").
   *  Defaults to the FDP logo. */
  image?: string;
  /** Keep this page out of search indexes (e.g. the form thank-you page). */
  noindex?: boolean;
}
const { title, description, image, noindex } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.short}` : `${SITE.name}`;
const desc =
  description ??
  "Foodservice Design Professionals plans and designs high-performing food service facilities for higher education, corporate, healthcare, casinos, culinary, and K-12 clients.";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

// Absolute URLs for canonical + social tags (Astro.site = https://fdp.org).
const origin = Astro.site?.href.replace(/\/$/, "") ?? "https://fdp.org";
const canonical = new URL(path, `${origin}/`).href;
// Default share card is the branded 1200x630 og-image.jpg; a page can override
// via the `image` prop (e.g. a news hero).
const ogImage = new URL(image ?? "/og-image.jpg", `${origin}/`).href;
const usingDefaultOg = !image;

// Organization + per-office LocalBusiness structured data (JSON-LD). Rendered on
// every page; the shared @id lets the office nodes reference the parent org.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${origin}/#organization`,
      name: SITE.name,
      alternateName: SITE.short,
      url: `${origin}/`,
      logo: `${origin}/fdp-logo.png`,
      image: `${origin}/fdp-logo.png`,
      email: SITE.proposalEmail,
      description:
        "Food service facility design and consulting firm serving K-12, higher education, corporate, healthcare, hospitality, and government clients nationally and internationally since 1967.",
      foundingDate: "1967",
      areaServed: "US",
    },
    ...OFFICES.map((o) => ({
      "@type": "LocalBusiness",
      "@id": `${origin}/#office-${o.city.toLowerCase()}`,
      name: `${SITE.name} — ${o.city}`,
      parentOrganization: { "@id": `${origin}/#organization` },
      url: `${origin}/contact`,
      image: `${origin}/fdp-logo.png`,
      telephone: o.phoneE164,
      email: SITE.proposalEmail,
      address: {
        "@type": "PostalAddress",
        streetAddress: o.street,
        addressLocality: o.locality,
        addressRegion: o.region,
        postalCode: o.postal,
        addressCountry: "US",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: o.lat,
        longitude: o.lng,
      },
    })),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    {
      usingDefaultOg && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:type" content="image/jpeg" />
          <meta
            property="og:image:alt"
            content="Foodservice Design Professionals — food service facility design & consulting · Dallas & Houston"
          />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schema)}
    />
    {
      SITE.gtmId && (
        <>
          {/* Consent Mode v2 defaults — MUST run before the GTM container loads.
              Everything denied until the visitor opts in via the banner; a saved
              "granted" choice is honored immediately on later page loads. Also
              defines window.gtag, which the banner uses to push consent updates. */}
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}var g='denied';try{if(localStorage.getItem('fdp-consent')==='granted')g='granted';}catch(e){}gtag('consent','default',{ad_storage:g,ad_user_data:g,ad_personalization:g,analytics_storage:g,functionality_storage:'granted',security_storage:'granted',wait_for_update:500});gtag('set','ads_data_redaction',true);gtag('set','url_passthrough',true);`}
          />
          <script
            is:inline
            set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${SITE.gtmId}');`}
          />
        </>
      )
    }
    {
      SITE.cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.cfBeaconToken })}
        />
      )
    }
  </head>
  <body>
    {
      SITE.gtmId && (
        <noscript
          is:inline
          set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${SITE.gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`}
        />
      )
    }
    <a href="#main" class="skip">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label={`${SITE.name} home`}>
          <img src="/fdp-logo.png" width="260" height="219" alt={SITE.name} />
        </a>
        <nav class="nav" aria-label="Primary">
          {
            NAV.map((item) => {
              const active =
                isActive(item.href) ||
                (item.children?.some((c) => isActive(c.href)) ?? false);
              return item.children ? (
                <div class="nav-item">
                  <a
                    href={item.href}
                    class:list={["nav-link", { active }]}
                    aria-haspopup="true"
                  >
                    {item.label}
                    <svg class="nav-caret" viewBox="0 0 10 6" aria-hidden="true">
                      <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                  <div class="nav-sub">
                    {item.children.map((c) => (
                      <a
                        href={c.href}
                        class:list={["nav-sublink", { active: isActive(c.href) }]}
                      >
                        {c.label}
                      </a>
                    ))}
                  </div>
                </div>
              ) : (
                <a href={item.href} class:list={["nav-link", { active }]}>
                  {item.label}
                </a>
              );
            })
          }
          <a href="/contact#proposal-form" class="btn btn-primary nav-cta">Request a Proposal</a>
        </nav>
        <button
          class="nav-burger"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
      <div id="mobile-menu" class="mobile-menu" hidden>
        {
          NAV.map((item) => (
            <>
              <a
                href={item.href}
                class:list={["mobile-link", { active: isActive(item.href) }]}
              >
                {item.label}
              </a>
              {item.children?.map((c) => (
                <a
                  href={c.href}
                  class:list={["mobile-link", "mobile-sublink", { active: isActive(c.href) }]}
                >
                  {c.label}
                </a>
              ))}
            </>
          ))
        }
        <a href="/contact#proposal-form" class="btn btn-primary mobile-cta">Request a Proposal</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <img src="/fdp-logo.png" width="260" height="219" alt={SITE.name} class="footer-logo" />
          <p class="footer-tag">{SITE.tagline}</p>
        </div>
        <div class="footer-col">
          <h2 class="footer-h">Offices</h2>
          {
            OFFICES.map((o) => (
              <p class="footer-office">
                <span class="footer-city">{o.city}</span>
                <span class="footer-area">{o.area}</span>
                <span class="footer-addr">{o.address}</span>
                <a href={o.phoneHref} class="footer-phone tabular">{o.phone}</a>
              </p>
            ))
          }
        </div>
        <div class="footer-col">
          <h2 class="footer-h">Start a project</h2>
          <p class="footer-muted">Send an RFP or ask a question.</p>
          <a href={`mailto:${SITE.proposalEmail}`} class="footer-mail">{SITE.proposalEmail}</a>
        </div>
      </div>
      <div class="container footer-base">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <span class="footer-cities">Dallas · Houston</span>
        {
          SITE.gtmId && (
            <button type="button" id="cookie-prefs" class="footer-cookie">
              Cookie preferences
            </button>
          )
        }
      </div>
    </footer>

    {SITE.gtmId && <ConsentBanner />}

    <style>
      .skip{
        position:absolute;left:-999px;top:0;background:var(--ink);color:#fff;
        padding:10px 16px;border-radius:0 0 8px 0;z-index:100;
      }
      .skip:focus{left:0}

      /* ---- Header ---- */
      .site-header{
        position:sticky;top:0;z-index:50;
        background:color-mix(in srgb, var(--paper) 88%, transparent);
        backdrop-filter:saturate(1.4) blur(10px);
        border-bottom:1px solid var(--line);
      }
      .header-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;height:76px}
      .brand img{height:52px;width:auto}
      .nav{display:flex;align-items:center;gap:clamp(14px,2vw,28px)}
      .nav-link{
        font-family:var(--font-display);font-weight:600;font-size:.96rem;text-decoration:none;
        color:var(--ink-soft);padding:6px 2px;position:relative;transition:color .15s ease;
      }
      .nav-link:hover{color:var(--ink)}
      .nav-link.active{color:var(--accent-ink)}
      .nav-link.active::after{
        content:"";position:absolute;left:0;right:0;bottom:-3px;height:2px;background:var(--accent);border-radius:2px;
      }
      .nav-cta{padding:10px 18px}

      /* Dropdown submenu (desktop) */
      .nav-item{position:relative;display:flex;align-items:center}
      .nav-item > .nav-link{display:inline-flex;align-items:center;gap:5px}
      .nav-caret{width:9px;height:6px;opacity:.65;transition:transform .18s ease}
      .nav-item:hover .nav-caret,.nav-item:focus-within .nav-caret{transform:rotate(180deg)}
      .nav-sub{
        position:absolute;top:calc(100% + 10px);left:50%;
        transform:translateX(-50%) translateY(-6px);
        min-width:190px;display:flex;flex-direction:column;
        background:var(--paper);border:1px solid var(--line);border-radius:12px;
        box-shadow:var(--shadow);padding:6px;
        opacity:0;visibility:hidden;transition:opacity .16s ease, transform .16s ease;z-index:60;
      }
      /* invisible bridge so the pointer can travel from link to panel */
      .nav-sub::before{content:"";position:absolute;top:-12px;left:0;right:0;height:12px}
      .nav-item:hover .nav-sub,.nav-item:focus-within .nav-sub{
        opacity:1;visibility:visible;transform:translateX(-50%) translateY(0);
      }
      .nav-sublink{
        font-family:var(--font-display);font-weight:600;font-size:.92rem;text-decoration:none;
        color:var(--ink-soft);padding:9px 12px;border-radius:8px;white-space:nowrap;
        transition:background .12s ease, color .12s ease;
      }
      .nav-sublink:hover{background:var(--accent-wash);color:var(--accent-ink)}
      .nav-sublink.active{color:var(--accent-ink);background:var(--accent-wash)}
      @media (prefers-reduced-motion:reduce){
        .nav-caret,.nav-sub{transition:none}
      }

      /* Hamburger — hidden on desktop */
      .nav-burger{
        display:none;flex-direction:column;justify-content:center;gap:5px;
        width:44px;height:44px;padding:0 10px;border:1px solid var(--line-strong);
        border-radius:10px;background:var(--paper);cursor:pointer;
      }
      .nav-burger span{display:block;height:2px;width:100%;background:var(--ink);border-radius:2px;transition:transform .2s ease, opacity .2s ease}
      .nav-burger[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
      .nav-burger[aria-expanded="true"] span:nth-child(2){opacity:0}
      .nav-burger[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

      .mobile-menu{
        position:absolute;top:100%;left:0;right:0;
        display:flex;flex-direction:column;gap:0;
        padding:4px clamp(18px,4vw,40px) 16px;
        border-top:1px solid var(--line);background:var(--paper);
        box-shadow:0 16px 28px -14px rgba(20,25,32,.28);
        max-height:calc(100dvh - 64px);overflow-y:auto;overscroll-behavior:contain;
      }
      /* `.mobile-menu{display:flex}` would otherwise override the [hidden]
         attribute the burger toggles, leaving the menu always open. */
      .mobile-menu[hidden]{display:none}
      .mobile-link{
        font-family:var(--font-display);font-weight:600;font-size:1rem;text-decoration:none;
        color:var(--ink-soft);padding:11px 4px;border-bottom:1px solid var(--line);
      }
      .mobile-link.active{color:var(--accent-ink)}
      .mobile-sublink{
        font-size:.98rem;padding-left:20px;color:var(--muted);
      }
      .mobile-sublink::before{
        content:"";display:inline-block;width:12px;height:1px;background:var(--line-strong);
        vertical-align:middle;margin-right:10px;
      }
      .mobile-cta{margin-top:14px;justify-content:center}

      @media (prefers-reduced-motion:reduce){
        .nav-burger span{transition:none}
      }
      @media (max-width:860px){
        /* Hide the whole desktop nav (links, the Who We Are dropdown, and CTA);
           the burger + mobile menu take over. Hiding .nav-link alone left the
           dropdown's link visible via its higher-specificity rule. */
        .nav{display:none}
        .nav-burger{display:flex}
        .header-inner{height:66px}
        .brand img{height:44px}
      }
      @media (min-width:861px){
        .mobile-menu{display:none !important}
      }

      /* ---- Footer ---- */
      .site-footer{background:var(--ink-900);color:#cfd6dd;margin-top:0}
      .footer-grid{
        display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;
        padding:clamp(44px,7vw,72px) 0 36px;
      }
      .footer-logo{height:48px;width:auto;margin-bottom:14px;
        /* logo has black linework — lift it onto a light chip so it reads on dark */
        background:#f4f5f3;padding:10px 14px;border-radius:10px;}
      .footer-tag{color:#9aa4ae;font-size:.95rem;max-width:34ch}
      .footer-h{font-family:var(--font-display);font-size:.82rem;letter-spacing:.12em;text-transform:uppercase;color:#fff;margin-bottom:14px}
      .footer-office{display:flex;flex-direction:column;margin-bottom:14px;line-height:1.4}
      .footer-city{font-family:var(--font-display);font-weight:600;color:#fff}
      .footer-area{font-size:.85rem;color:#8b95a0}
      .footer-addr{font-size:.85rem;color:#9aa4ae;margin:2px 0 4px;max-width:26ch}
      .footer-phone{color:#cfd6dd;text-decoration:none;font-size:.95rem}
      .footer-phone:hover{color:#fff}
      .footer-muted{color:#9aa4ae;font-size:.95rem;margin-bottom:8px}
      .footer-mail{color:var(--on-dark-accent);text-decoration:none;font-family:var(--font-mono);font-size:.9rem}
      .footer-mail:hover{text-decoration:underline}
      .footer-base{
        display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;
        padding:20px 0 30px;border-top:1px solid rgba(255,255,255,.08);
        font-family:var(--font-mono);font-size:12px;color:#7f8a95;
      }
      .footer-cookie{
        background:none;border:0;padding:0;cursor:pointer;
        font-family:var(--font-mono);font-size:12px;color:#7f8a95;
        text-decoration:underline;text-underline-offset:2px;
      }
      .footer-cookie:hover{color:#cfd6dd}
      @media (max-width:720px){
        .footer-grid{grid-template-columns:1fr;gap:30px}
      }
    </style>

    <script>
      const burger = document.querySelector(".nav-burger");
      const menu = document.getElementById("mobile-menu");
      if (burger && menu) {
        burger.addEventListener("click", () => {
          const open = menu.hasAttribute("hidden");
          menu.toggleAttribute("hidden", !open);
          burger.setAttribute("aria-expanded", String(open));
          burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        });
      }
    </script>
  </body>
</html>
