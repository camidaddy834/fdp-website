---
import "../styles/global.css";
import { SITE, NAV, OFFICES } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.short}` : `${SITE.name}`;
const desc =
  description ??
  "Foodservice Design Professionals plans and designs high-performing foodservice facilities for higher education, corporate, healthcare, casinos, culinary, and K-12 clients.";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label={`${SITE.name} home`}>
          <img src="/fdp-logo.png" width="720" height="411" alt={SITE.name} />
        </a>
        <nav class="nav" aria-label="Primary">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class:list={["nav-link", { active: isActive(item.href) }]}
              >
                {item.label}
              </a>
            ))
          }
          <a href="/contact" class="btn btn-primary nav-cta">Request a Proposal</a>
        </nav>
        <button
          class="nav-burger"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
      <div id="mobile-menu" class="mobile-menu" hidden>
        {
          NAV.map((item) => (
            <a
              href={item.href}
              class:list={["mobile-link", { active: isActive(item.href) }]}
            >
              {item.label}
            </a>
          ))
        }
        <a href="/contact" class="btn btn-primary mobile-cta">Request a Proposal</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <img src="/fdp-logo.png" width="720" height="411" alt={SITE.name} class="footer-logo" />
          <p class="footer-tag">{SITE.tagline}</p>
        </div>
        <div class="footer-col">
          <h4 class="footer-h">Offices</h4>
          {
            OFFICES.map((o) => (
              <p class="footer-office">
                <span class="footer-city">{o.city}</span>
                <span class="footer-area">{o.area}</span>
                <span class="footer-addr">{o.address}</span>
                <a href={o.phoneHref} class="footer-phone tabular">{o.phone}</a>
              </p>
            ))
          }
        </div>
        <div class="footer-col">
          <h4 class="footer-h">Start a project</h4>
          <p class="footer-muted">Send an RFP or ask a question.</p>
          <a href={`mailto:${SITE.proposalEmail}`} class="footer-mail">{SITE.proposalEmail}</a>
        </div>
      </div>
      <div class="container footer-base">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <span class="footer-cities">Dallas · Houston</span>
      </div>
    </footer>

    <style>
      .skip{
        position:absolute;left:-999px;top:0;background:var(--ink);color:#fff;
        padding:10px 16px;border-radius:0 0 8px 0;z-index:100;
      }
      .skip:focus{left:0}

      /* ---- Header ---- */
      .site-header{
        position:sticky;top:0;z-index:50;
        background:color-mix(in srgb, var(--paper) 88%, transparent);
        backdrop-filter:saturate(1.4) blur(10px);
        border-bottom:1px solid var(--line);
      }
      .header-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;height:76px}
      .brand img{height:44px;width:auto}
      .nav{display:flex;align-items:center;gap:clamp(14px,2vw,28px)}
      .nav-link{
        font-family:var(--font-display);font-weight:600;font-size:.96rem;text-decoration:none;
        color:var(--ink-soft);padding:6px 2px;position:relative;transition:color .15s ease;
      }
      .nav-link:hover{color:var(--ink)}
      .nav-link.active{color:var(--accent-ink)}
      .nav-link.active::after{
        content:"";position:absolute;left:0;right:0;bottom:-3px;height:2px;background:var(--accent);border-radius:2px;
      }
      .nav-cta{padding:10px 18px}

      /* Hamburger — hidden on desktop */
      .nav-burger{
        display:none;flex-direction:column;justify-content:center;gap:5px;
        width:44px;height:44px;padding:0 10px;border:1px solid var(--line-strong);
        border-radius:10px;background:var(--paper);cursor:pointer;
      }
      .nav-burger span{display:block;height:2px;width:100%;background:var(--ink);border-radius:2px;transition:transform .2s ease, opacity .2s ease}
      .nav-burger[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
      .nav-burger[aria-expanded="true"] span:nth-child(2){opacity:0}
      .nav-burger[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

      .mobile-menu{
        display:flex;flex-direction:column;gap:2px;
        padding:10px clamp(18px,4vw,40px) 20px;
        border-top:1px solid var(--line);background:var(--paper);
      }
      .mobile-link{
        font-family:var(--font-display);font-weight:600;font-size:1.05rem;text-decoration:none;
        color:var(--ink-soft);padding:13px 4px;border-bottom:1px solid var(--line);
      }
      .mobile-link.active{color:var(--accent-ink)}
      .mobile-cta{margin-top:14px;justify-content:center}

      @media (prefers-reduced-motion:reduce){
        .nav-burger span{transition:none}
      }
      @media (max-width:860px){
        .nav-link,.nav-cta{display:none}
        .nav-burger{display:flex}
        .header-inner{height:66px}
        .brand img{height:38px}
      }
      @media (min-width:861px){
        .mobile-menu{display:none !important}
      }

      /* ---- Footer ---- */
      .site-footer{background:var(--ink-900);color:#cfd6dd;margin-top:0}
      .footer-grid{
        display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;
        padding:clamp(44px,7vw,72px) 0 36px;
      }
      .footer-logo{height:48px;width:auto;margin-bottom:14px;
        /* logo has black linework — lift it onto a light chip so it reads on dark */
        background:#f4f5f3;padding:10px 14px;border-radius:10px;}
      .footer-tag{color:#9aa4ae;font-size:.95rem;max-width:34ch}
      .footer-h{font-family:var(--font-display);font-size:.82rem;letter-spacing:.12em;text-transform:uppercase;color:#fff;margin-bottom:14px}
      .footer-office{display:flex;flex-direction:column;margin-bottom:14px;line-height:1.4}
      .footer-city{font-family:var(--font-display);font-weight:600;color:#fff}
      .footer-area{font-size:.85rem;color:#8b95a0}
      .footer-addr{font-size:.85rem;color:#9aa4ae;margin:2px 0 4px;max-width:26ch}
      .footer-phone{color:#cfd6dd;text-decoration:none;font-size:.95rem}
      .footer-phone:hover{color:#fff}
      .footer-muted{color:#9aa4ae;font-size:.95rem;margin-bottom:8px}
      .footer-mail{color:var(--on-dark-accent);text-decoration:none;font-family:var(--font-mono);font-size:.9rem}
      .footer-mail:hover{text-decoration:underline}
      .footer-base{
        display:flex;justify-content:space-between;align-items:center;gap:16px;
        padding:20px 0 30px;border-top:1px solid rgba(255,255,255,.08);
        font-family:var(--font-mono);font-size:12px;color:#7f8a95;
      }
      @media (max-width:720px){
        .footer-grid{grid-template-columns:1fr;gap:30px}
      }
    </style>

    <script>
      const burger = document.querySelector(".nav-burger");
      const menu = document.getElementById("mobile-menu");
      if (burger && menu) {
        burger.addEventListener("click", () => {
          const open = menu.hasAttribute("hidden");
          menu.toggleAttribute("hidden", !open);
          burger.setAttribute("aria-expanded", String(open));
          burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        });
      }
    </script>
  </body>
</html>
